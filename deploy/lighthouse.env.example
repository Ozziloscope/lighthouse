# Lighthouse configuration. Copy to /etc/lighthouse/lighthouse.env and edit.
# Keep this file readable by root only: sudo chmod 600 /etc/lighthouse/lighthouse.env

# Listen only on localhost; the reverse proxy or tunnel is the only thing that talks to the app.
HOST=127.0.0.1
PORT=3000
DATA_DIR=/var/lib/lighthouse

# The exact address people type in the browser (scheme + host, no trailing slash).
PUBLIC_URL=https://desk.example.com

# The site is served over HTTPS, so cookies are Secure and HSTS is sent.
COOKIE_SECURE=true

# A proxy or tunnel sits in front and adds X-Forwarded-For.
TRUST_PROXY=true
TRUST_PROXY_HOPS=1

# Cloudflare Tunnel only: read the client IP from Cloudflare's header.
#CLIENT_IP_HEADER=cf-connecting-ip

# Optional: your own first-run setup code. If unset, a random one is printed in the log at startup.
#SETUP_TOKEN=

# How long a sign-in lasts, in days.
SESSION_DAYS=7

# Time zone for daily task reminders and times shown in alerts.
TZ=America/Chicago

# ---------------------------------------------------------------------------
# Website intake (optional): lets the windpoint.net form handler raise tickets.
# A separate, private port. Never point the tunnel at it. Setup: docs/WEBSITE-INTAKE.md
# ---------------------------------------------------------------------------
# Make one with: openssl rand -hex 32
#INTAKE_TOKEN=
#INTAKE_HOST=127.0.0.1
#INTAKE_PORT=3001
#INTAKE_PRINT_GROUP="3D Printing"
#INTAKE_IT_GROUP="IT Jobs"

# ---------------------------------------------------------------------------
# Email and text alerts (optional). Full setup steps: docs/ALERTS.md
# ---------------------------------------------------------------------------
# Email over SMTP. Keep the quotes around SMTP_FROM.
#SMTP_HOST=email-smtp.us-east-1.amazonaws.com
#SMTP_PORT=587
#SMTP_SECURE=starttls
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM="Lighthouse Service Desk <desk@example.com>"
# Only for an internal mail server whose certificate comes from a private CA (PEM file).
#SMTP_CA_FILE=/etc/lighthouse/mail-ca.pem

# Text messages via Twilio.
#SMS_PROVIDER=twilio
#TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#TWILIO_API_KEY_SECRET=
#TWILIO_FROM=+18885550100

# Limits and options.
#SMS_MAX_PER_HOUR=60
#SMS_MAX_PER_USER_PER_HOUR=15
#SMS_INCLUDE_DETAILS=true
#SMS_DEFAULT_COUNTRY=1
#ALERT_DAILY_HOUR=8
