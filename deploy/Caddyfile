# Caddy reverse proxy for Lighthouse. Replace desk.example.com with your hostname.
# Caddy fetches and renews the HTTPS certificate automatically once DNS points at this server.
# Install: sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
desk.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
	log {
		output file /var/log/caddy/lighthouse-access.log {
			roll_size 50MiB
			roll_keep 10
		}
	}
}
